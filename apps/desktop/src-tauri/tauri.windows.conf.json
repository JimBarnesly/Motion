{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../dist/node-runtime.exe": "node-runtime.exe" },
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "offlineInstaller", "silent": true },
      "nsis": { "installMode": "currentUser", "languages": ["English"], "displayLanguageSelector": false }
    }
  }
}
