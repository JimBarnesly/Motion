{
  "name": "motion-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "An open, local-first personal knowledge workspace",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "benchmark": "npm run build --workspace @motion/search && node scripts/benchmark.mjs",
    "dev": "npm run dev --workspace @motion/web",
    "inventory:dependencies": "node scripts/dependency-inventory.mjs --output docs/dependency-inventory.json",
    "inventory:dependencies:check": "node scripts/dependency-inventory.mjs --check docs/dependency-inventory.json",
    "lint": "node scripts/lint.mjs",
    "test:e2e": "playwright test e2e/web.spec.ts",
    "test:destructive-accessibility": "playwright test e2e/destructive-accessibility.spec.ts",
    "test:dependency-inventory": "node --test scripts/dependency-inventory.test.mjs",
    "test:dependency-policy-change": "node --test scripts/dependency-policy-change-gate.test.mjs",
    "test:vulnerability-gate": "node --test scripts/vulnerability-gate.test.mjs",
    "test:vulnerability-collector": "node --test scripts/vulnerability-collector.test.mjs",
    "static-analysis": "node scripts/static-analysis.mjs --policy static-analysis-policy.json --output artifacts/static-analysis/source-security.json",
    "test:static-analysis": "node --test scripts/static-analysis.test.mjs",
    "test:diagnostic-leakage": "npm run build --workspace @motion/app-service --workspace @motion/observability && node --test scripts/diagnostic-leakage.test.mjs",
    "test:release-provenance": "node --test scripts/release-provenance.test.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "test:secret-scan": "node --test scripts/secret-scan.test.mjs",
    "scan:unsafe-defaults": "node scripts/unsafe-default-scan.mjs",
    "test:unsafe-defaults": "node --test scripts/unsafe-default-scan.test.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:release:structure": "node scripts/verify-release-structure.mjs",
    "test:benchmark": "npm run build --workspace @motion/search && node --test scripts/benchmark.test.mjs",
    "test:offline": "npm run build --workspace @motion/app-service && node --test --test-name-pattern='offline across separate process' packages/app-service/dist/test/app-service.test.js && node scripts/check-offline-assets.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
