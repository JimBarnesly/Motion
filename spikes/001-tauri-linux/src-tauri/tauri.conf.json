{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Motion Tauri Spike",
  "version": "0.0.1",
  "identifier": "local.motion.spike",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Motion Tauri Spike",
        "width": 900,
        "height": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"]
  }
}
